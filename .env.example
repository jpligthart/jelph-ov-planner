# Docker images: registry + namespace to push to / pull from (no trailing slash),
# e.g. registry.example.com/team. Used by deploy/push-images.sh and compose.
IMAGE_REGISTRY=
# IMAGE_TAG=latest
# IMAGE_PLATFORMS=linux/amd64,linux/arm64

# Subscription key from https://apiportal.ns.nl/ (NsApp product)
NS_API_KEY=

# Login. One entry per user, comma-separated: name:hash,name:hash
# Create an entry with: npm run hash-password -w @jelph/api -- <name>
# (on the server: docker compose run --rm api node apps/api/dist/hash-password.js <name>)
# Required in production; when empty in development, login is disabled.
AUTH_USERS=
# Signs session cookies. Generate with: openssl rand -base64 32
# Changing it logs everyone out.
AUTH_SECRET=

# API (optional overrides)
# PORT=3000
# HOST=0.0.0.0

# Transitous multimodal door-to-door (https://transitous.org/api/)
# TRANSITOUS_ENABLED=true
# TRANSITOUS_BASE_URL=https://api.transitous.org
# TRANSITOUS_USER_AGENT=JelphOVPlanner/0.3.0 (+https://jelph.nl; you@example.com)

# Shared request budget protecting the NS quota (300 requests / 5 min for free
# keys), for all users together. One plan costs up to ~15 NS calls, a search 1.
# Active only when NODE_ENV=production (Docker); RATE_LIMIT_ENABLED overrides.
# RATE_LIMIT_ENABLED=true
# PLAN_LIMIT_PER_5_MIN=12
# SEARCH_LIMIT_PER_5_MIN=100
