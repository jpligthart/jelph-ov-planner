# Subscription key from https://apiportal.ns.nl/ (NsApp product)
NS_API_KEY=

# API (optional overrides)
# PORT=3000
# HOST=0.0.0.0

# Transitous multimodal door-to-door (https://transitous.org/api/)
# TRANSITOUS_ENABLED=true
# TRANSITOUS_BASE_URL=https://api.transitous.org
# TRANSITOUS_USER_AGENT=JelphOVPlanner/0.3.0 (+https://jelph.nl; you@example.com)

# Shared request budget protecting the NS quota (300 requests / 5 min for free
# keys), for all users together. One plan costs up to ~15 NS calls, a search 1.
# Active only when NODE_ENV=production (Docker); RATE_LIMIT_ENABLED overrides.
# RATE_LIMIT_ENABLED=true
# PLAN_LIMIT_PER_5_MIN=12
# SEARCH_LIMIT_PER_5_MIN=100
